# Copy to .env, edit, then: set -a; source .env; set +a
# Never commit .env. Activate the appropriate model environment first.
# Vendored helpers/dependencies are selected automatically; no REPO needed.
PYTHON_BIN=python
MODEL=/path/to/model_checkpoint_directory
PROMPTS=/path/to/evaluation_prompts.txt
# Optional overrides: ORBITQUANT_ROOT and H3_DIFFUSERS_ROOT
# H3-specific dependencies/input (when not already installed)
MANIFEST=/path/to/h3_inference_manifest.json
# Self Forcing inputs
# SELF_REPO defaults to third_party/self_forcing.
SELF_WAN_MODEL_ROOT=/path/to/Wan2.1-T2V-1.3B
CHECKPOINT=/path/to/self_forcing_dmd.pt
# Optional additional integration modules, separated by colons
EXTRA_PYTHONPATH=
CUDA_DEVICES=0
CUDA_DEVICE=0
